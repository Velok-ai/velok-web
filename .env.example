# Required. Resend API key with permission to send from VELOK_FROM_EMAIL's domain.
RESEND_API_KEY=
# Where every form submission is emailed. Comma-separated for several people.
VELOK_LEAD_EMAIL=david@velok.ai
# Sender. The domain must be verified in the Resend account behind RESEND_API_KEY.
VELOK_FROM_EMAIL=Velok via Lemonbrand <hello@lemonbrand.io>
# Optional. Resend segment id for contacts who ticked marketing consent.
# Left empty, the route finds or creates the segment "Velok — Parcours IA".
VELOK_RESEND_SEGMENT_ID=
